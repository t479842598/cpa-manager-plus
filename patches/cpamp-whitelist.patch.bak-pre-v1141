diff --git a/apps/web/src/hooks/useVisualConfigApiKeyWhitelist.test.ts b/apps/web/src/hooks/useVisualConfigApiKeyWhitelist.test.ts
new file mode 100644
index 00000000..bb62f13e
--- /dev/null
+++ b/apps/web/src/hooks/useVisualConfigApiKeyWhitelist.test.ts
@@ -0,0 +1,171 @@
+import { act, createElement, createRef, useImperativeHandle, type Ref } from 'react';
+import { create, type ReactTestRenderer } from 'react-test-renderer';
+import { describe, expect, it } from 'vitest';
+import { parse as parseYaml } from 'yaml';
+import { useVisualConfig } from './useVisualConfig';
+
+type UseVisualConfigResult = ReturnType<typeof useVisualConfig>;
+
+type UseVisualConfigHarness = {
+  getCurrent: () => UseVisualConfigResult;
+  unmount: () => void;
+};
+
+function HookHarness({ hookRef }: { hookRef: Ref<UseVisualConfigResult> }) {
+  const hook = useVisualConfig();
+  useImperativeHandle(hookRef, () => hook, [hook]);
+  return null;
+}
+
+const mountUseVisualConfig = (): UseVisualConfigHarness => {
+  const hookRef = createRef<UseVisualConfigResult>();
+  let renderer: ReactTestRenderer | null = null;
+
+  act(() => {
+    renderer = create(createElement(HookHarness, { hookRef }));
+  });
+
+  return {
+    getCurrent: () => {
+      if (!hookRef.current) {
+        throw new Error('Failed to mount useVisualConfig test harness');
+      }
+      return hookRef.current;
+    },
+    unmount: () => {
+      if (!renderer) return;
+      act(() => {
+        renderer?.unmount();
+      });
+    },
+  };
+};
+
+const RESTRICTED = 'sk-restricted-key';
+const FREE = 'sk-free-key';
+
+const baseYaml = [
+  'port: 8317',
+  'api-keys:',
+  `  - ${FREE}`,
+  `  - ${RESTRICTED}`,
+  'api-key-models:',
+  `  ${RESTRICTED}:`,
+  '    - hublinuxdo/deepseek-v4-flash',
+  '    - 天机阁/gpt-5.4',
+  '',
+].join('\n');
+
+type CpaConfig = {
+  port?: number;
+  'api-keys'?: string[];
+  'api-key-models'?: Record<string, string[]>;
+};
+
+describe('useVisualConfig per-key model whitelist', () => {
+  it('parses api-key-models into key=model1,model2 lines', () => {
+    const harness = mountUseVisualConfig();
+    act(() => {
+      expect(harness.getCurrent().loadVisualValuesFromYaml(baseYaml).ok).toBe(true);
+    });
+
+    const values = harness.getCurrent().visualValues;
+    expect(values.apiKeysText.split('\n').map((line: string) => line.trim())).toEqual([
+      FREE,
+      RESTRICTED,
+    ]);
+    expect(values.apiKeyModelsText).toBe(
+      `${RESTRICTED}=hublinuxdo/deepseek-v4-flash,天机阁/gpt-5.4`
+    );
+    harness.unmount();
+  });
+
+  // F-04: a single visual write must carry both the key list and the whitelist,
+  // which is what lets the API key dialog save without a second page-level save.
+  it('writes api-keys and api-key-models together in one apply pass', () => {
+    const harness = mountUseVisualConfig();
+    act(() => {
+      expect(harness.getCurrent().loadVisualValuesFromYaml(baseYaml).ok).toBe(true);
+      harness.getCurrent().setVisualValues({
+        apiKeysText: [FREE, RESTRICTED, 'sk-brand-new-key'].join('\n'),
+        apiKeyModelsText: [
+          `${RESTRICTED}=hublinuxdo/deepseek-v4-flash,天机阁/gpt-5.4`,
+          'sk-brand-new-key=魔芋/deepseek-v4-pro-0813',
+        ].join('\n'),
+      });
+    });
+
+    const nextYaml = harness.getCurrent().applyVisualChangesToYaml(baseYaml);
+    const parsed = parseYaml(nextYaml) as CpaConfig;
+
+    expect(parsed.port).toBe(8317);
+    expect(parsed['api-keys']).toEqual([FREE, RESTRICTED, 'sk-brand-new-key']);
+    expect(parsed['api-key-models']).toEqual({
+      [RESTRICTED]: ['hublinuxdo/deepseek-v4-flash', '天机阁/gpt-5.4'],
+      'sk-brand-new-key': ['魔芋/deepseek-v4-pro-0813'],
+    });
+    harness.unmount();
+  });
+
+  it('round-trips a freshly written whitelist back into the editor text', () => {
+    const harness = mountUseVisualConfig();
+    act(() => {
+      expect(harness.getCurrent().loadVisualValuesFromYaml(baseYaml).ok).toBe(true);
+      harness.getCurrent().setVisualValues({
+        apiKeyModelsText: `${RESTRICTED}=a/one,b/two`,
+      });
+    });
+    const nextYaml = harness.getCurrent().applyVisualChangesToYaml(baseYaml);
+
+    const readBack = mountUseVisualConfig();
+    act(() => {
+      expect(readBack.getCurrent().loadVisualValuesFromYaml(nextYaml).ok).toBe(true);
+    });
+    expect(readBack.getCurrent().visualValues.apiKeyModelsText).toBe(
+      `${RESTRICTED}=a/one,b/two`
+    );
+    harness.unmount();
+    readBack.unmount();
+  });
+
+  // Dropping every model for the last key must remove api-key-models entirely
+  // so CPA treats the key as unrestricted rather than as allowed-nothing.
+  it('deletes api-key-models when the whitelist becomes empty but keeps api-keys', () => {
+    const harness = mountUseVisualConfig();
+    act(() => {
+      expect(harness.getCurrent().loadVisualValuesFromYaml(baseYaml).ok).toBe(true);
+      harness.getCurrent().setVisualValues({ apiKeyModelsText: '' });
+    });
+
+    const parsed = parseYaml(
+      harness.getCurrent().applyVisualChangesToYaml(baseYaml)
+    ) as CpaConfig;
+
+    expect(parsed['api-key-models']).toBeUndefined();
+    expect(parsed['api-keys']).toEqual([FREE, RESTRICTED]);
+    harness.unmount();
+  });
+
+  it('ignores malformed whitelist lines instead of writing partial entries', () => {
+    const harness = mountUseVisualConfig();
+    act(() => {
+      expect(harness.getCurrent().loadVisualValuesFromYaml(baseYaml).ok).toBe(true);
+      harness.getCurrent().setVisualValues({
+        apiKeyModelsText: [
+          'no-equals-sign',
+          `=orphan-models`,
+          `${RESTRICTED}=  , valid/model `,
+        ].join('\n'),
+      });
+    });
+
+    const parsed = parseYaml(
+      harness.getCurrent().applyVisualChangesToYaml(baseYaml)
+    ) as CpaConfig;
+
+    expect(parsed['api-key-models']).toEqual({
+      [RESTRICTED]: ['valid/model'],
+    });
+    harness.unmount();
+  });
+});
