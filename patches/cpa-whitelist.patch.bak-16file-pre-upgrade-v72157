+// requests are returned untouched. It returns the resulting body and whether it changed.
+func normalizeOpenAIChatMessages(body []byte) ([]byte, bool) {
+	messages := gjson.GetBytes(body, "messages")
+	if !messages.IsArray() {
+		return body, false
+	}
+
+	out := body
+	changed := false
+
+	for i, m := range messages.Array() {
+		role := m.Get("role").String()
+		path := fmt.Sprintf("messages.%d", i)
+
+		// Some upstreams (serde/Rust based) only accept system/user/assistant/tool and reject
+		// the OpenAI/Codex `developer` role. Map it to system, which is semantically equivalent.
+		if role == "developer" {
+			out, _ = sjson.SetBytes(out, path+".role", "system")
+			changed = true
+			role = "system"
+		}
+
+		if role != "assistant" {
+			continue
+		}
+
