+package management
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+)
+
+// managementModelsProtocol is the registry handler type used by the
+// OpenAI-compatible catalogue exposed on /v1/models.
+const managementModelsProtocol = "openai"
+
+// GetModels serves GET /v0/management/models.
+//
+// It returns the *full* model catalogue from the global registry. Unlike
+// GET /v1/models it is authenticated with the management secret key and is
+// deliberately NOT filtered by the per-key model whitelist (api-key-models).
+//
+// The control panel needs this endpoint because /v1/models is filtered per
+// key: when the first configured api key happens to be a restricted one,
+// probing /v1/models with it yields only that key's whitelist, so the panel
+// could no longer offer every model as a candidate while an administrator is
+// editing a whitelist. Reading the registry directly always yields the
+// complete list regardless of which keys are restricted.
+func (h *Handler) GetModels(c *gin.Context) {
+	protocol := strings.TrimSpace(c.Query("protocol"))
+	if protocol == "" {
+		protocol = managementModelsProtocol
+	}
+
+	models := registry.GetGlobalRegistry().GetAvailableModels(protocol)
+
+	data := make([]map[string]any, 0, len(models))
+	for _, model := range models {
+		id := ""
+		if v, ok := model["id"].(string); ok {
+			id = strings.TrimSpace(v)
+		}
+		if id == "" {
+			continue
+		}
+		item := map[string]any{"id": id, "object": model["object"]}
+		if v, ok := model["created"]; ok {
+			item["created"] = v
+		}
+		if v, ok := model["owned_by"]; ok {
+			item["owned_by"] = v
+		}
+		data = append(data, item)
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"object":   "list",
+		"protocol": protocol,
+		"total":    len(data),
+		"data":     data,
+	})
+}
