+
+// registerWhitelistTestModels adds uniquely-named models to the global registry
+// so the assertions below stay valid regardless of what other tests registered.
+func registerWhitelistTestModels(t *testing.T) (first, second, outside string) {
+	t.Helper()
+	id := "whitelist-test-client"
+	first = "whitelist-test/alpha"
+	second = "whitelist-test/beta"
+	outside = "whitelist-test/gamma"
+	registry.GetGlobalRegistry().RegisterClient(id, "OpenAI", []*registry.ModelInfo{
+		{ID: first, Object: "model", OwnedBy: "test"},
+		{ID: second, Object: "model", OwnedBy: "test"},
+		{ID: outside, Object: "model", OwnedBy: "test"},
+	})
+	t.Cleanup(func() {
+		registry.GetGlobalRegistry().UnregisterClient(id)
+	})
+	return
+}
+
+func modelIDsFromResponse(t *testing.T, body []byte) []string {
+	t.Helper()
+	var payload struct {
+		Object string           `json:"object"`
+		Data   []map[string]any `json:"data"`
+	}
+	if err := json.Unmarshal(body, &payload); err != nil {
+		t.Fatalf("decode response: %v (%s)", err, body)
+	}
+	if payload.Object != "list" {
+		t.Fatalf("object = %q, want list", payload.Object)
+	}
+	ids := make([]string, 0, len(payload.Data))
+	for _, m := range payload.Data {
+		if v, ok := m["id"].(string); ok {
+			ids = append(ids, v)
+		}
+	}
+	return ids
+}
+
+// F-06: /v1/models must expose only the whitelisted models for a restricted key.
+func TestOpenAIModelsFiltersByPerKeyWhitelist(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	first, second, outside := registerWhitelistTestModels(t)
+
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	ctx := sdkaccess.WithAuthMetadata(context.Background(), map[string]string{
+		"model-whitelist": first + "," + second,
+	})
+	c.Request = httptest.NewRequest(http.MethodGet, "/v1/models", nil).WithContext(ctx)
+
+	(&OpenAIAPIHandler{}).OpenAIModels(c)
+
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200", recorder.Code)
+	}
+	ids := modelIDsFromResponse(t, recorder.Body.Bytes())
+	set := make(map[string]struct{}, len(ids))
+	for _, v := range ids {
+		set[v] = struct{}{}
+	}
+	if _, ok := set[first]; !ok {
+		t.Fatalf("whitelisted model %q missing from %v", first, ids)
+	}
+	if _, ok := set[second]; !ok {
+		t.Fatalf("whitelisted model %q missing from %v", second, ids)
+	}
+	if _, ok := set[outside]; ok {
+		t.Fatalf("non-whitelisted model %q must not be listed, got %v", outside, ids)
+	}
+}
