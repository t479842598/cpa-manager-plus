+// newWhitelistHandler builds a BaseAPIHandler with the minimal wiring that
+// enforceModelWhitelist needs (it only reads the context and its receiver).
+func newWhitelistHandler() *BaseAPIHandler {
+	return &BaseAPIHandler{Cfg: &config.SDKConfig{}}
+}
+
+func ctxWithWhitelist(models ...string) context.Context {
+	return sdkaccess.WithAuthMetadata(context.Background(), map[string]string{
+		"model-whitelist": strings.Join(models, ","),
+	})
+}
+
+// F-05: a restricted key must be refused for models outside its whitelist.
+func TestEnforceModelWhitelistRejectsModelOutsideWhitelist(t *testing.T) {
+	h := newWhitelistHandler()
+	ctx := ctxWithWhitelist("hublinuxdo/deepseek-v4-flash", "天机阁/gpt-5.4")
+
+	msg := h.enforceModelWhitelist(ctx, "FB/glm-5.3-flash")
+	if msg == nil {
+		t.Fatal("expected an error for a model outside the whitelist, got nil")
+	}
+	if msg.StatusCode != http.StatusForbidden {
+		t.Fatalf("StatusCode = %d, want %d", msg.StatusCode, http.StatusForbidden)
+	}
+	body := msg.Error.Error()
+	for _, want := range []string{"model_not_allowed", "invalid_request_error", "FB/glm-5.3-flash"} {
+		if !strings.Contains(body, want) {
+			t.Fatalf("error body %q does not contain %q", body, want)
+		}
+	}
+	if !strings.Contains(body, `"param":"model"`) {
+		t.Fatalf("error body %q should point at the model param", body)
+	}
+}
+
+// F-05: a model inside the whitelist must pass.
+func TestEnforceModelWhitelistAllowsListedModel(t *testing.T) {
+	h := newWhitelistHandler()
+	ctx := ctxWithWhitelist("hublinuxdo/deepseek-v4-flash", "天机阁/gpt-5.4")
+
+	if msg := h.enforceModelWhitelist(ctx, "hublinuxdo/deepseek-v4-flash"); msg != nil {
+		t.Fatalf("expected allow for a whitelisted model, got %+v", msg)
+	}
+}
+
+// Surrounding whitespace in either the configured whitelist or the requested
+// model must not change the decision (keys are hand-edited in config.yaml).
+func TestEnforceModelWhitelistTrimsWhitespace(t *testing.T) {
+	h := newWhitelistHandler()
+	ctx := sdkaccess.WithAuthMetadata(context.Background(), map[string]string{
+		"model-whitelist": "  hublinuxdo/deepseek-v4-flash , 天机阁/gpt-5.4  ",
+	})
+
+	if msg := h.enforceModelWhitelist(ctx, "  hublinuxdo/deepseek-v4-flash  "); msg != nil {
+		t.Fatalf("expected padded whitelisted model to pass, got %+v", msg)
+	}
+	if msg := h.enforceModelWhitelist(ctx, "  FB/glm-5.3-flash  "); msg == nil {
+		t.Fatal("expected padded non-whitelisted model to be rejected")
+	}
+}
+
+// An unrestricted key (no metadata attached at all) must never be limited.
+func TestEnforceModelWhitelistNoopForUnrestrictedKey(t *testing.T) {
+	h := newWhitelistHandler()
