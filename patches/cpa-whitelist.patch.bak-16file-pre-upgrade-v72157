+		var reasoningParts []string
+		existingRC := m.Get("reasoning_content")
+		if existingRC.Exists() && existingRC.String() != "" {
+			reasoningParts = append(reasoningParts, existingRC.String())
+		}
+
+		content := m.Get("content")
+		var textParts []string
+		removedFromArray := false
+
+		if content.IsArray() {
+			for _, block := range content.Array() {
+				switch block.Get("type").String() {
+				case "thinking", "redacted_thinking":
+					t := block.Get("thinking").String()
+					if t == "" {
+						t = block.Get("data").String()
+					}
+					if t == "" {
+						t = block.Get("text").String()
+					}
+					if t != "" {
+						reasoningParts = append(reasoningParts, t)
+						removedFromArray = true
+					}
+				case "reasoning":
+					// Compatible with clients that send {type:"reasoning", text:"..."}.
+					if t := block.Get("text").String(); t != "" {
+						reasoningParts = append(reasoningParts, t)
+						removedFromArray = true
+					}
+				case "text", "output_text":
+					if t := block.Get("text").String(); t != "" {
+						textParts = append(textParts, t)
+					}
+				}
+			}
+		}
+
+		joined := strings.Join(reasoningParts, "")
+
+		// DeepSeek thinking mode requires every assistant history message to carry a
+		// reasoning_content field, even an empty string. Missing it triggers a 400
+		// "must be passed back". Always ensure the field is present with the joined value.
+		if !existingRC.Exists() || existingRC.String() != joined {
+			out, _ = sjson.SetBytes(out, path+".reasoning_content", joined)
+			changed = true
+		}
+
+		// If the content array carried thinking blocks, fold the visible content back to a
+		// plain text string so we don't leave unknown block types to the upstream.
+		if content.IsArray() && removedFromArray {
+			out, _ = sjson.SetBytes(out, path+".content", strings.Join(textParts, ""))
