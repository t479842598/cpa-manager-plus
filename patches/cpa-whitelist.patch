+// openAIStreamTerminalInfo inspects an upstream OpenAI chat-completion chunk and
+// reports whether it carries a non-null finish_reason, tool-call deltas, and any
+// choice object at all. Used to detect upstreams that close a stream without a
+// terminal finish_reason chunk, which strict OpenAI clients (e.g. pi-ai) reject.
+func openAIStreamTerminalInfo(payload []byte) (hasFinish bool, hasToolCalls bool, hasChoice bool) {
+	choices := gjson.GetBytes(payload, "choices")
+	if !choices.IsArray() {
+		return
+	}
+	choices.ForEach(func(_, choice gjson.Result) bool {
+		hasChoice = true
+		if fr := choice.Get("finish_reason"); fr.Exists() && fr.Type == gjson.String && fr.String() != "" {
+			hasFinish = true
+		}
+		if tc := choice.Get("delta.tool_calls"); tc.Exists() && tc.IsArray() && len(tc.Array()) > 0 {
+			hasToolCalls = true
+		}
+		return true
+	})
+	return
+}
+
+// synthesizeOpenAIStreamFinish builds an OpenAI chat-completion chunk carrying a
+// terminal finish_reason ("tool_calls" when tool-call deltas were streamed,
+// otherwise "stop"). It is injected before [DONE] when the upstream ended a
+// clean stream without ever sending one, so downstream translators and clients
+// observe a protocol-complete termination.
+func synthesizeOpenAIStreamFinish(id, model string, hasToolCalls bool) []byte {
+	reason := "stop"
+	if hasToolCalls {
+		reason = "tool_calls"
+	}
+	if id == "" {
+		id = "chatcmpl-" + strings.ReplaceAll(uuid.NewString(), "-", "")
+	}
+	chunk := map[string]any{
+		"id":      id,
+		"object":  "chat.completion.chunk",
+		"created": time.Now().Unix(),
+		"model":   model,
+		"choices": []any{map[string]any{
+			"index":         0,
+			"delta":         map[string]any{},
+			"finish_reason": reason,
+		}},
+	}
+	body, err := json.Marshal(chunk)
+	if err != nil {
+		return nil
+	}
+	return body
+}
