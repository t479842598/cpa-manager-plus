@@ -0,0 +1,101 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// A whitelist entry removed through the management API must actually disappear
+// from config.yaml. SaveConfigPreserveComments merges the generated config into
+// the existing YAML tree, which keeps unknown keys of mappings it does not
+// explicitly prune — so api-key-models has to be pruned like the oauth-* maps.
+func TestSaveConfigPreserveComments_RemovesDeletedAPIKeyModels(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	initialYAML := `api-keys:
+  - sk-free
+  - sk-restricted
+api-key-models:
+  sk-restricted:
+    - model-a
+    - model-b
+  sk-stale:
+    - model-c
+`
+	if errWrite := os.WriteFile(configPath, []byte(initialYAML), 0o600); errWrite != nil {
+		t.Fatalf("os.WriteFile() error = %v", errWrite)
+	}
+
+	cfg := &Config{
+		SDKConfig: SDKConfig{
+			APIKeys: []string{"sk-free", "sk-restricted"},
+			APIKeyModels: map[string][]string{
+				"sk-restricted": {"model-a"},
+			},
+		},
+	}
+
+	if errSave := SaveConfigPreserveComments(configPath, cfg); errSave != nil {
+		t.Fatalf("SaveConfigPreserveComments() error = %v", errSave)
+	}
+
+	savedBytes, errRead := os.ReadFile(configPath)
+	if errRead != nil {
+		t.Fatalf("os.ReadFile() error = %v", errRead)
+	}
+	savedText := string(savedBytes)
+
+	if strings.Contains(savedText, "sk-stale") {
+		t.Errorf("saved YAML still contains the removed key sk-stale; got:\n%s", savedText)
+	}
+	if strings.Contains(savedText, "model-b") {
+		t.Errorf("saved YAML still contains the removed model model-b; got:\n%s", savedText)
+	}
+	if !strings.Contains(savedText, "model-a") {
+		t.Errorf("saved YAML lost the remaining whitelist entry; got:\n%s", savedText)
+	}
+
+	loadedCfg, errLoad := LoadConfigOptional(configPath, false)
+	if errLoad != nil {
+		t.Fatalf("LoadConfigOptional() error = %v", errLoad)
+	}
+	if got := loadedCfg.APIKeyModels["sk-restricted"]; len(got) != 1 || got[0] != "model-a" {
+		t.Fatalf("reloaded whitelist = %#v, want [model-a]", got)
+	}
+	if _, exists := loadedCfg.APIKeyModels["sk-stale"]; exists {
+		t.Fatalf("reloaded whitelist still has sk-stale: %#v", loadedCfg.APIKeyModels)
+	}
+}
+
+// Clearing every whitelist entry must drop the whole mapping, not leave an
+// empty one behind.
+func TestSaveConfigPreserveComments_DropsEmptyAPIKeyModels(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	initialYAML := `api-keys:
+  - sk-restricted
+api-key-models:
+  sk-restricted:
+    - model-a
+`
+	if errWrite := os.WriteFile(configPath, []byte(initialYAML), 0o600); errWrite != nil {
+		t.Fatalf("os.WriteFile() error = %v", errWrite)
+	}
+
+	cfg := &Config{
+		SDKConfig: SDKConfig{
+			APIKeys: []string{"sk-restricted"},
+		},
+	}
+	if errSave := SaveConfigPreserveComments(configPath, cfg); errSave != nil {
+		t.Fatalf("SaveConfigPreserveComments() error = %v", errSave)
+	}
+
+	loadedCfg, errLoad := LoadConfigOptional(configPath, false)
+	if errLoad != nil {
+		t.Fatalf("LoadConfigOptional() error = %v", errLoad)
+	}
+	if len(loadedCfg.APIKeyModels) != 0 {
+		t.Fatalf("reloaded whitelist = %#v, want empty", loadedCfg.APIKeyModels)
+	}
+}
