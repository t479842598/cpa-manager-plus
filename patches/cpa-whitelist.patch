+
+	applyGPT6CodexIdentityHeaders(req.Header, "gpt-6-astra", "https://anyrouter.top/v1", auth)
+
+	if got := req.Header.Get("Originator"); got != codexExecOriginator {
+		t.Fatalf("Originator = %q, want %q", got, codexExecOriginator)
+	}
+	if got := req.Header.Get("User-Agent"); got != codexExecUserAgent {
+		t.Fatalf("User-Agent = %q, want %q", got, codexExecUserAgent)
+	}
+}
+
+// An operator who pinned Originator / User-Agent through the provider `headers:` block
+// keeps full control - the automatic GPT-6 rule must not fight explicit config.
+func TestApplyGPT6CodexIdentityYieldsToOperatorHeaders(t *testing.T) {
+	cases := []struct {
+		name  string
+		attrs map[string]string
+	}{
+		{name: "originator pinned", attrs: map[string]string{"auth_kind": "apikey", "header:Originator": "codex_cli_rs"}},
+		{name: "user agent pinned", attrs: map[string]string{"auth_kind": "apikey", "header:user-agent": "my-relay/1.0"}},
+		{name: "lowercase originator pinned", attrs: map[string]string{"auth_kind": "apikey", "header:originator": "codex-tui"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			headers := http.Header{}
+			headers.Set("Originator", codexOriginator)
+			headers.Set("User-Agent", codexUserAgent)
+			auth := &cliproxyauth.Auth{Provider: "codex", Attributes: tc.attrs}
+
+			applyGPT6CodexIdentityHeaders(headers, "gpt-6-astra", "https://anyrouter.top/v1", auth)
+
+			if got := headers.Get("Originator"); got != codexOriginator {
+				t.Fatalf("Originator = %q, want operator value %q", got, codexOriginator)
+			}
+			if got := headers.Get("User-Agent"); got != codexUserAgent {
+				t.Fatalf("User-Agent = %q, want operator value %q", got, codexUserAgent)
+			}
+		})
+	}
+}
+
+// models.json `config.override_header` is applied after the GPT-6 rule and must win.
+func TestApplyGPT6CodexIdentityYieldsToModelOverrideHeaders(t *testing.T) {
+	reg := registry.GetGlobalRegistry()
+	clientID := "test-gpt6-model-override"
+	reg.RegisterClient(clientID, "codex", []*registry.ModelInfo{{
+		ID: "gpt-6-testoverride",
+		Config: &registry.ModelConfig{
+			OverrideHeader: map[string]string{
+				"user-agent": "pinned-ua/1.0",
+				"originator": "pinned-origin",
+			},
+		},
+	}})
+	t.Cleanup(func() { reg.UnregisterClient(clientID) })
+
+	headers := http.Header{}
+	applyGPT6CodexIdentityHeaders(headers, "gpt-6-testoverride", "https://relay.example.com/v1", nil)
+	if got := headers.Get("Originator"); got != codexExecOriginator {
+		t.Fatalf("Originator = %q, want %q before override", got, codexExecOriginator)
+	}
+
+	applyModelHeaderOverrides(headers, "gpt-6-testoverride")
+
+	if got := headers.Get("Originator"); got != "pinned-origin" {
+		t.Fatalf("Originator = %q, want pinned-origin", got)
+	}
+	if got := headers.Get("User-Agent"); got != "pinned-ua/1.0" {
+		t.Fatalf("User-Agent = %q, want pinned-ua/1.0", got)
+	}
+}
+
+func TestApplyGPT6CodexIdentityNilInputs(t *testing.T) {
+	applyGPT6CodexIdentityHeaders(nil, "gpt-6-astra", "https://anyrouter.top/v1", nil)
+
+	headers := http.Header{}
+	applyGPT6CodexIdentityHeaders(headers, "", "https://anyrouter.top/v1", nil)
+	if len(headers) != 0 {
+		t.Fatalf("headers = %#v, want empty for blank model", headers)
+	}
+}
