+package auth
+
+import (
+	"testing"
+
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+// Deployment regression: an openai-compatibility model without an explicit
+// `thinking:` block must keep the extended reasoning levels on the execution
+// path too. Otherwise ValidateConfig clamps a client's xhigh/max down to high
+// and the upstream never sees the selected level.
+func TestAttachResolvedAPIKeyModelInfoKeepsExtendedDefaultThinkingLevels(t *testing.T) {
+	manager := NewManager(nil, nil, nil)
+	manager.SetConfig(&internalconfig.Config{OpenAICompatibility: []internalconfig.OpenAICompatibility{{
+		Name:    "keyless",
+		Prefix:  "tenant",
+		BaseURL: "https://example.com/v1",
+		Models: []internalconfig.OpenAICompatibilityModel{
+			{Name: "deepseek-v4.1-flash", Alias: "public-model"},
+		},
+	}}})
+	auth := &Auth{
+		ID:       "auth-extended-levels",
+		Provider: "openai-compatibility:keyless",
+		Prefix:   "tenant",
+		Attributes: map[string]string{
+			AttributeSource: "config:keyless[0]",
+			"compat_name":   "keyless",
+			"provider_key":  "openai-compatibility:keyless",
+		},
+	}
+	registerCapabilityTestAuth(t, manager, auth)
+	models, _, _, routing := manager.executionModelCandidatesWithAlias(auth, "tenant/public-model")
+	if len(models) == 0 {
+		t.Fatal("expected at least one execution model for the keyless compatibility provider")
+	}
+	req := attachResolvedAPIKeyModelInfo(routing, cliproxyexecutor.Request{}, auth, "tenant/public-model", models[0])
+	assertResolvedThinkingLevels(t, req, "low", "medium", "high", "xhigh", "max")
+}
diff --git a/sdk/cliproxy/openai_compat_thinking_defaults_test.go b/sdk/cliproxy/openai_compat_thinking_defaults_test.go
new file mode 100644
index 00000000..b78b4a6e
--- /dev/null
+++ b/sdk/cliproxy/openai_compat_thinking_defaults_test.go
@@ -0,0 +1,70 @@
+package cliproxy
+
+import (
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+)
+
+// Deployment regression: an openai-compatibility model without an explicit
+// `thinking:` block must not advertise only low/medium/high. Upstream's default
+// made the thinking pipeline clamp a client's xhigh/max down to high before the
+// request ever reached the upstream, so the level selected in the client UI
+// silently arrived as "high".
+func TestBuildOpenAICompatibilityConfigModelsKeepsExtendedThinkingLevels(t *testing.T) {
+	compat := &config.OpenAICompatibility{
+		Name: "buddy",
+		Models: []config.OpenAICompatibilityModel{
+			{
+				Name:  "deepseek-v4.1-flash",
+				Alias: "buddy/deepseek-v4.1-flash",
+			},
+			{
+				// Explicit config still wins over the default.
+				Name:     "glm-5.3-flash",
+				Alias:    "buddy/glm-5.3-flash",
+				Thinking: &registry.ThinkingSupport{Levels: []string{"high"}},
+			},
+		},
+	}
+
+	models := buildOpenAICompatibilityConfigModels(compat)
+	if len(models) != 2 {
+		t.Fatalf("model count = %d, want 2", len(models))
+	}
+
+	byID := make(map[string]*ModelInfo, len(models))
+	for _, model := range models {
+		if model != nil {
+			byID[model.ID] = model
+		}
+	}
+
+	defaulted := byID["buddy/deepseek-v4.1-flash"]
+	if defaulted == nil || defaulted.Thinking == nil {
+		t.Fatalf("defaulted model = %#v, want thinking support", defaulted)
+	}
+	for _, want := range []string{"low", "medium", "high", "xhigh", "max"} {
+		if !containsLevel(defaulted.Thinking.Levels, want) {
+			t.Fatalf("default thinking levels = %v, missing %q", defaulted.Thinking.Levels, want)
+		}
+	}
+
+	explicit := byID["buddy/glm-5.3-flash"]
+	if explicit == nil || explicit.Thinking == nil {
+		t.Fatalf("explicit model = %#v, want thinking support", explicit)
+	}
+	if len(explicit.Thinking.Levels) != 1 || explicit.Thinking.Levels[0] != "high" {
+		t.Fatalf("explicit thinking levels = %v, want [high]", explicit.Thinking.Levels)
+	}
+}
+
+func containsLevel(levels []string, want string) bool {
+	for _, level := range levels {
+		if level == want {
+			return true
+		}
+	}
+	return false
+}
