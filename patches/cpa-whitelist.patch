--- /dev/null
+++ b/sdk/access/apikey_metadata.go
@@ -0,0 +1,84 @@
+package access
+
+import (
+	"context"
+	"strings"
+)
+
+// apiKeyMetadataContextKey carries the authenticated API key metadata (including
+// the optional model whitelist) on the request context so downstream execution
+// paths can enforce per-key model restrictions without the gin context.
+type apiKeyMetadataContextKeyType struct{}
+
+var apiKeyMetadataContextKey apiKeyMetadataContextKeyType
+
+// apiKeyModelWhitelistContextKey carries the parsed model whitelist slice for the
+// authenticated API key, or nil when the key has no whitelist configured.
+type apiKeyModelWhitelistContextKeyType struct{}
+
+var apiKeyModelWhitelistContextKey apiKeyModelWhitelistContextKeyType
+
+// ContextKeyModelWhitelist returns the typed context key used to carry the parsed
+// model whitelist. It is exported so middleware in other packages can set the
+// value with a shared key.
+func ContextKeyModelWhitelist() any { return apiKeyModelWhitelistContextKey }
+
+// ContextKeyMetadata returns the typed context key used to carry the raw auth
+// metadata map.
+func ContextKeyMetadata() any { return apiKeyMetadataContextKey }
+
+// WithAuthMetadata attaches the auth result metadata to ctx.
+func WithAuthMetadata(ctx context.Context, metadata map[string]string) context.Context {
+	if ctx == nil || len(metadata) == 0 {
+		return ctx
+	}
+	ctx = context.WithValue(ctx, apiKeyMetadataContextKey, metadata)
+	if raw, ok := metadata["model-whitelist"]; ok && raw != "" {
+		var models []string
+		for _, part := range strings.Split(raw, ",") {
+			if m := strings.TrimSpace(part); m != "" {
+				models = append(models, m)
+			}
+		}
+		if len(models) > 0 {
+			ctx = context.WithValue(ctx, apiKeyModelWhitelistContextKey, models)
+		}
+	}
+	return ctx
+}
+
+// ModelWhitelistFromContext returns the model whitelist for the authenticated
+// API key, or nil when the key is unrestricted or no metadata was attached.
+func ModelWhitelistFromContext(ctx context.Context) []string {
+	if ctx == nil {
+		return nil
+	}
+	if v, ok := ctx.Value(apiKeyModelWhitelistContextKey).([]string); ok {
+		return v
+	}
+	if meta, ok := ctx.Value(apiKeyMetadataContextKey).(map[string]string); ok {
+		if raw, ok := meta["model-whitelist"]; ok && raw != "" {
+			var models []string
+			for _, part := range strings.Split(raw, ",") {
+				if m := strings.TrimSpace(part); m != "" {
+					models = append(models, m)
+				}
+			}
+			if len(models) > 0 {
+				return models
+			}
+		}
+	}
+	return nil
+}
+
+// MetadataFromContext returns the raw auth metadata map attached to ctx (nil if none).
+func MetadataFromContext(ctx context.Context) map[string]string {
+	if ctx == nil {
+		return nil
+	}
+	if meta, ok := ctx.Value(apiKeyMetadataContextKey).(map[string]string); ok {
+		return meta
+	}
+	return nil
+}
