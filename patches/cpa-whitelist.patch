diff --git a/internal/api/handlers/management/config_api_key_models.go b/internal/api/handlers/management/config_api_key_models.go
new file mode 100644
index 00000000..2e89d39d
--- /dev/null
+++ b/internal/api/handlers/management/config_api_key_models.go
@@ -0,0 +1,199 @@
+package management
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+// api-key-models: map[string][]string (per client API key model whitelist)
+//
+// These handlers mirror the api-keys endpoints so the control panel can persist
+// a key together with its whitelist through the management API instead of
+// rewriting config.yaml as a whole. Every mutation goes through h.persist,
+// which saves the file and triggers the normal reload path
+// (watcher -> access provider rebuild), so a whitelist change takes effect
+// immediately.
+
+// normalizeAPIKeyModels trims/dedupes model names and drops empty entries.
+// Keys are API key values and therefore case sensitive; they are only trimmed.
+func normalizeAPIKeyModels(entries map[string][]string) map[string][]string {
+	if len(entries) == 0 {
+		return nil
+	}
+	out := make(map[string][]string, len(entries))
+	for rawKey, models := range entries {
+		key := strings.TrimSpace(rawKey)
+		if key == "" {
+			continue
+		}
+		normalized := normalizeWhitelistModels(models)
+		if len(normalized) == 0 {
+			// An empty whitelist means "unrestricted", so the entry is dropped
+			// entirely rather than stored as an allow-nothing list.
+			continue
+		}
+		out[key] = normalized
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
+
+func normalizeWhitelistModels(models []string) []string {
+	if len(models) == 0 {
+		return nil
+	}
+	out := make([]string, 0, len(models))
+	seen := make(map[string]struct{}, len(models))
+	for _, raw := range models {
+		m := strings.TrimSpace(raw)
+		if m == "" {
+			continue
+		}
+		if _, exists := seen[m]; exists {
+			continue
+		}
+		seen[m] = struct{}{}
+		out = append(out, m)
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
+
+func (h *Handler) GetAPIKeyModels(c *gin.Context) {
+	models := h.cfg.APIKeyModels
+	if models == nil {
+		models = map[string][]string{}
+	}
+	c.JSON(http.StatusOK, gin.H{"api-key-models": models})
+}
+
+func (h *Handler) PutAPIKeyModels(c *gin.Context) {
+	data, err := c.GetRawData()
+	if err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "failed to read body"})
+		return
+	}
+	entries, ok := parseAPIKeyModelsBody(data)
+	if !ok {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid body"})
+		return
+	}
+	h.cfg.APIKeyModels = normalizeAPIKeyModels(entries)
+	h.persist(c)
+}
+
+// parseAPIKeyModelsBody accepts either the bare mapping
+// ({"sk-a":["model-a"]}) or the wrapped form GET returns
+// ({"api-key-models":{...}} / {"items":{...}}), so a read-modify-write round
+// trip against this API works without reshaping the payload.
+func parseAPIKeyModelsBody(data []byte) (map[string][]string, bool) {
+	trimmed := strings.TrimSpace(string(data))
+	if trimmed == "" || trimmed == "null" {
+		return nil, true
+	}
+	var raw map[string]json.RawMessage
+	if errRaw := json.Unmarshal(data, &raw); errRaw != nil {
+		return nil, false
+	}
+	for _, wrapperKey := range []string{"api-key-models", "items"} {
+		value, ok := raw[wrapperKey]
+		if !ok {
+			continue
+		}
+		var entries map[string][]string
+		if errValue := json.Unmarshal(value, &entries); errValue != nil {
+			return nil, false
+		}
+		return entries, true
+	}
+	entries := make(map[string][]string, len(raw))
+	for key, value := range raw {
+		var models []string
+		if errValue := json.Unmarshal(value, &models); errValue != nil {
+			return nil, false
+		}
+		entries[key] = models
+	}
+	return entries, true
+}
+
+// PatchAPIKeyModels declaratively syncs the whitelist of a single API key:
+// a non-empty models list sets the entry, an empty list removes it (making the
+// key unrestricted). Both directions are idempotent and always answer 200 so
+// the control panel can express "this key should have exactly these models"
+// without having to interpret 404s when an entry is already absent.
+func (h *Handler) PatchAPIKeyModels(c *gin.Context) {
+	var body struct {
+		APIKey *string  `json:"api-key"`
+		Key    *string  `json:"key"`
+		Models []string `json:"models"`
+	}
+	if err := c.ShouldBindJSON(&body); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid body"})
+		return
+	}
+	rawKey := body.APIKey
+	if rawKey == nil {
+		rawKey = body.Key
+	}
+	if rawKey == nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "missing api-key"})
+		return
+	}
+	key := strings.TrimSpace(*rawKey)
+	if key == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "missing api-key"})
+		return
+	}
+
+	normalized := normalizeWhitelistModels(body.Models)
+	if len(normalized) == 0 {
+		if h.cfg.APIKeyModels != nil {
+			delete(h.cfg.APIKeyModels, key)
+			if len(h.cfg.APIKeyModels) == 0 {
+				h.cfg.APIKeyModels = nil
+			}
+		}
+		h.persist(c)
+		return
+	}
+
+	if h.cfg.APIKeyModels == nil {
+		h.cfg.APIKeyModels = make(map[string][]string)
+	}
+	h.cfg.APIKeyModels[key] = normalized
+	h.persist(c)
+}
+
+// DeleteAPIKeyModels removes one key's whitelist entry. Unlike PATCH this is an
+// explicit removal, so an unknown key reports 404 instead of silently succeeding.
+func (h *Handler) DeleteAPIKeyModels(c *gin.Context) {
+	key := strings.TrimSpace(c.Query("api-key"))
+	if key == "" {
+		key = strings.TrimSpace(c.Query("key"))
+	}
+	if key == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "missing api-key"})
+		return
+	}
+	if h.cfg.APIKeyModels == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "api key whitelist not found"})
+		return
+	}
+	if _, ok := h.cfg.APIKeyModels[key]; !ok {
+		c.JSON(http.StatusNotFound, gin.H{"error": "api key whitelist not found"})
+		return
+	}
+	delete(h.cfg.APIKeyModels, key)
+	if len(h.cfg.APIKeyModels) == 0 {
+		h.cfg.APIKeyModels = nil
+	}
+	h.persist(c)
+}
