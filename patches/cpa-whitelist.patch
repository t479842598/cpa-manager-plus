+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// newMergeSystemTestExecutor wires an httptest upstream that records the outbound body,
+// mirroring the setup used by the max-tokens normalization tests.
+func newMergeSystemTestExecutor(t *testing.T, merge bool, streamResponse string) (*OpenAICompatExecutor, *cliproxyauth.Auth, *[]byte) {
+	t.Helper()
+
+	var gotBody []byte
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		gotBody = body
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(streamResponse))
+	}))
+	t.Cleanup(server.Close)
+
+	cfg := &config.Config{
+		OpenAICompatibility: []config.OpenAICompatibility{{
+			Name:                "test-compat",
+			BaseURL:             server.URL + "/v1",
+			MergeSystemIntoUser: merge,
+			Models: []config.OpenAICompatibilityModel{
+				{Name: "upstream-model", Alias: "alias-model"},
+			},
+		}},
+	}
+
+	auth := &cliproxyauth.Auth{
+		Provider: "openai-compatibility",
+		Attributes: map[string]string{
+			"base_url":     server.URL + "/v1",
+			"api_key":      "test-key",
+			"compat_name":  "test-compat",
+			"provider_key": "test-compat",
+		},
+	}
+
+	return NewOpenAICompatExecutor("openai-compatibility", cfg), auth, &gotBody
+}
+
+const mergeSystemChatResponse = `{"id":"chatcmpl-1","choices":[{"message":{"role":"assistant","content":"hello"},"finish_reason":"stop"}]}`
+
+const mergeSystemStreamResponse = "data: {\"id\":\"chatcmpl-1\",\"choices\":[{\"delta\":{\"content\":\"hi\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
+
+func TestOpenAICompatExecutorSystemMergeDisabledLeavesBodyUntouched(t *testing.T) {
+	executor, auth, gotBody := newMergeSystemTestExecutor(t, false, mergeSystemChatResponse)
+
+	payload := []byte(`{"model":"alias-model","messages":[{"role":"system","content":"sys prompt"},{"role":"user","content":"hello"}]}`)
+	if _, err := executor.Execute(context.Background(), auth, cliproxyexecutor.Request{
+		Model:   "alias-model",
+		Payload: payload,
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai")}); err != nil {
+		t.Fatalf("Execute error: %v", err)
+	}
+
+	messages := gjson.GetBytes(*gotBody, "messages").Array()
+	if len(messages) != 2 {
+		t.Fatalf("disabled flag must not rewrite messages, got %d: %s", len(messages), string(*gotBody))
+	}
+	if role := messages[0].Get("role").String(); role != "system" {
+		t.Fatalf("disabled flag must keep the system role, got %q", role)
+	}
+}
+
+func TestOpenAICompatExecutorSystemMergeEnabledRewritesNonStreamBody(t *testing.T) {
+	executor, auth, gotBody := newMergeSystemTestExecutor(t, true, mergeSystemChatResponse)
+
+	payload := []byte(`{"model":"alias-model","messages":[{"role":"system","content":"sys prompt"},{"role":"user","content":"hello"}]}`)
+	if _, err := executor.Execute(context.Background(), auth, cliproxyexecutor.Request{
+		Model:   "alias-model",
+		Payload: payload,
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai")}); err != nil {
+		t.Fatalf("Execute error: %v", err)
+	}
+
+	messages := gjson.GetBytes(*gotBody, "messages").Array()
+	if len(messages) != 1 {
+		t.Fatalf("expected the system message to be folded away, got %d: %s", len(messages), string(*gotBody))
+	}
+	if role := messages[0].Get("role").String(); role != "user" {
+		t.Fatalf("remaining role = %q, want user", role)
+	}
+	if content := messages[0].Get("content").String(); content != "sys prompt\n\nhello" {
+		t.Fatalf("merged content = %q, want %q", content, "sys prompt\n\nhello")
+	}
+}
+
+func TestOpenAICompatExecutorSystemMergeEnabledRewritesStreamBody(t *testing.T) {
+	executor, auth, gotBody := newMergeSystemTestExecutor(t, true, mergeSystemStreamResponse)
+
+	payload := []byte(`{"model":"alias-model","messages":[{"role":"system","content":"stream sys"},{"role":"user","content":"hello"}],"stream":true}`)
+	stream, err := executor.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{
+		Model:   "alias-model",
+		Payload: payload,
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai"), Stream: true})
+	if err != nil {
+		t.Fatalf("ExecuteStream error: %v", err)
+	}
+	for range stream.Chunks {
+		// Drain so the upstream request is fully issued.
+	}
+
+	messages := gjson.GetBytes(*gotBody, "messages").Array()
+	if len(messages) != 1 {
+		t.Fatalf("streaming path must also fold the system message, got %d: %s", len(messages), string(*gotBody))
+	}
+	if content := messages[0].Get("content").String(); !strings.HasPrefix(content, "stream sys") {
+		t.Fatalf("streaming merged content = %q, want prefix %q", content, "stream sys")
