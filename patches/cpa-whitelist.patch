+func TestApplyGPT6CodexIdentityHeaders(t *testing.T) {
+	cases := []struct {
+		name       string
+		model      string
+		baseURL    string
+		auth       *cliproxyauth.Auth
+		wantOrigin string
+	}{
+		{
+			name:       "gpt6 custom relay gets codex_exec identity",
+			model:      "gpt-6-astra",
+			baseURL:    "https://anyrouter.top/v1",
+			auth:       &cliproxyauth.Auth{Provider: "codex", Attributes: map[string]string{"auth_kind": "apikey"}},
+			wantOrigin: codexExecOriginator,
+		},
+		{
+			name:       "gpt6 suffixed model on custom relay",
+			model:      "gpt-6-astra(xhigh)",
+			baseURL:    "https://relay.example.com/v1",
+			wantOrigin: codexExecOriginator,
+		},
+		{
+			name:       "prefixed gpt6 model on custom relay",
+			model:      "teamA/gpt-6-astra",
+			baseURL:    "https://relay.example.com/v1",
+			wantOrigin: codexExecOriginator,
+		},
+		{
+			name:       "official chatgpt backend keeps codex-tui identity",
+			model:      "gpt-6-astra",
+			baseURL:    "https://chatgpt.com/backend-api/codex",
+			wantOrigin: codexOriginator,
+		},
+		{
+			name:       "empty base url means official default",
+			model:      "gpt-6-astra",
+			baseURL:    "",
+			wantOrigin: codexOriginator,
+		},
+		{
+			name:       "non gpt6 model on custom relay untouched",
+			model:      "gpt-5.5",
+			baseURL:    "https://relay.example.com/v1",
+			wantOrigin: codexOriginator,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			headers := http.Header{}
+			headers.Set("Originator", codexOriginator)
+			headers.Set("User-Agent", codexUserAgent)
+
+			applyGPT6CodexIdentityHeaders(headers, tc.model, tc.baseURL, tc.auth)
+
+			if got := headers.Get("Originator"); got != tc.wantOrigin {
+				t.Fatalf("Originator = %q, want %q", got, tc.wantOrigin)
+			}
+			wantCodexExec := tc.wantOrigin == codexExecOriginator
+			if got := headers.Get("User-Agent"); wantCodexExec && got != codexExecUserAgent {
+				t.Fatalf("User-Agent = %q, want %q", got, codexExecUserAgent)
+			} else if !wantCodexExec && got != codexUserAgent {
+				t.Fatalf("User-Agent = %q, want %q", got, codexUserAgent)
+			}
+			session := codexSessionHeaderValue(headers)
+			if wantCodexExec && session == "" {
+				t.Fatal("expected Session_id to be set together with the codex_exec identity")
+			}
+			if !wantCodexExec && session != "" {
+				t.Fatalf("Session_id = %q, want empty for non GPT-6 / official upstream", session)
+			}
+		})
+	}
+}
+
+// The codex_exec identity must survive cloaking: cloaking runs first inside
+// applyCodexHeaders, then the GPT-6 rule rewrites the identity.
+func TestApplyGPT6CodexIdentityOverridesCloaking(t *testing.T) {
+	req, err := http.NewRequest(http.MethodPost, "https://anyrouter.top/v1/responses", nil)
+	if err != nil {
+		t.Fatalf("NewRequest() error = %v", err)
+	}
+	auth := &cliproxyauth.Auth{Provider: "codex", Attributes: map[string]string{"auth_kind": "apikey"}}
+	cfg := &config.Config{}
+
+	applyCodexHeaders(req, auth, "sk-test", true, cfg)
+	if got := req.Header.Get("Originator"); got != codexOriginator {
+		t.Fatalf("precondition: Originator after cloaking = %q, want %q", got, codexOriginator)
+	}
+
+	applyGPT6CodexIdentityHeaders(req.Header, "gpt-6-astra", "https://anyrouter.top/v1", auth)
+
+	if got := req.Header.Get("Originator"); got != codexExecOriginator {
+		t.Fatalf("Originator = %q, want %q", got, codexExecOriginator)
+	}
+	if got := req.Header.Get("User-Agent"); got != codexExecUserAgent {
+		t.Fatalf("User-Agent = %q, want %q", got, codexExecUserAgent)
+	}
+}
+
+// A client-sent Originator (e.g. a ZCode/browser style header) must not leak upstream
+// for GPT-6 requests: the relay keys its channel off that header.
+func TestApplyGPT6CodexIdentityDropsClientOriginator(t *testing.T) {
+	req, err := http.NewRequest(http.MethodPost, "https://anyrouter.top/v1/responses", nil)
+	if err != nil {
