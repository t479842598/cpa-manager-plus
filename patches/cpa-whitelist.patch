+// isGPT6FamilyModel reports whether the model id belongs to the GPT-6 family
+// (gpt-6, gpt-6-astra, gpt-6.0, prefixed names such as teamA/gpt-6-astra, and
+// thinking-suffixed ids).
+func isGPT6FamilyModel(model string) bool {
+	name := strings.ToLower(strings.TrimSpace(model))
+	if name == "" {
+		return false
+	}
+	if slash := strings.LastIndex(name, "/"); slash >= 0 {
+		name = name[slash+1:]
+	}
+	return name == "gpt-6" || strings.HasPrefix(name, "gpt-6-") || strings.HasPrefix(name, "gpt-6.")
+}
+
+// isOfficialCodexBaseURL reports whether the upstream base URL is the first-party
+// ChatGPT backend. An empty value means the executor default
+// (https://chatgpt.com/backend-api/codex).
+func isOfficialCodexBaseURL(baseURL string) bool {
+	trimmed := strings.ToLower(strings.TrimSpace(baseURL))
+	if trimmed == "" {
+		return true
+	}
+	return strings.Contains(trimmed, "chatgpt.com") || strings.Contains(trimmed, "openai.com")
+}
+
+// hasOperatorHeader reports whether the operator pinned the header explicitly through a
+// provider `headers:` block (surfaced as the `header:<name>` auth attribute).
+func hasOperatorHeader(auth *cliproxyauth.Auth, name string) bool {
+	if auth == nil || len(auth.Attributes) == 0 {
+		return false
+	}
+	for key := range auth.Attributes {
+		if !strings.HasPrefix(key, "header:") {
+			continue
+		}
+		if strings.EqualFold(strings.TrimSpace(strings.TrimPrefix(key, "header:")), name) {
+			return true
+		}
+	}
+	return false
+}
+
+// applyGPT6CodexIdentityHeaders forces the Codex CLI (`codex_exec`) identity headers on
+// GPT-6 family requests, so third-party Codex relays that key their upstream channel off
+// `Originator` work out of the box, without per-provider `headers:` config or
+// `codex.disable-codex-cloaking`.
+//
+// It deliberately stays narrow:
+//   - only GPT-6 family model ids,
+//   - only for non-official upstreams (the first-party ChatGPT backend keeps its own identity),
+//   - and it yields to explicitly configured `Originator`/`User-Agent` provider headers and to
+//     models.json `config.override_header` (applied after this helper).
+func applyGPT6CodexIdentityHeaders(headers http.Header, model string, baseURL string, auth *cliproxyauth.Auth) {
+	if headers == nil || !isGPT6FamilyModel(model) || isOfficialCodexBaseURL(baseURL) {
+		return
+	}
+	if hasOperatorHeader(auth, "Originator") || hasOperatorHeader(auth, "User-Agent") {
+		return
+	}
+	headers.Set("Originator", codexExecOriginator)
+	headers.Set("User-Agent", codexExecUserAgent)
+	if codexSessionHeaderValue(headers) == "" {
+		headers.Set("Session_id", uuid.NewString())
+	}
+}
