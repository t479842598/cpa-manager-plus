+// enforceModelWhitelist returns an error when the authenticated API key has a
+// model whitelist configured and modelName is not in it. When the key is
+// unrestricted (no whitelist) or no metadata is attached, it returns nil.
+func (h *BaseAPIHandler) enforceModelWhitelist(ctx context.Context, modelName string) *interfaces.ErrorMessage {
+	if ctx == nil || h == nil {
+		return nil
+	}
+	whitelist := sdkaccess.ModelWhitelistFromContext(ctx)
+	if len(whitelist) == 0 {
+		return nil
+	}
+	requested := strings.TrimSpace(modelName)
+	if requested == "" {
+		return nil
+	}
+	allowed := make(map[string]struct{}, len(whitelist))
+	for _, m := range whitelist {
+		allowed[strings.TrimSpace(m)] = struct{}{}
+	}
+	if _, ok := allowed[requested]; ok {
+		return nil
+	}
+	body := `{"error":{"message":"","type":"invalid_request_error","code":"model_not_allowed","param":"model"}}`
+	msg := fmt.Sprintf("model %q is not allowed for this API key", requested)
+	body, errSet := sjson.Set(body, "error.message", msg)
+	if errSet != nil {
+		body = `{"error":{"message":"model not allowed for this API key","type":"invalid_request_error","code":"model_not_allowed","param":"model"}}`
+	}
+	return &interfaces.ErrorMessage{
+		StatusCode: http.StatusForbidden,
+		Error:      errors.New(body),
+	}
+}
