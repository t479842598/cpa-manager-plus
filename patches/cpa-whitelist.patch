+func TestMergeSystemMessagesIntoUserWithoutUserMessage(t *testing.T) {
+	input := []byte(`{"model":"m","messages":[` +
+		`{"role":"system","content":"only system"},` +
+		`{"role":"assistant","content":"A1"}]}`)
+
+	got := MergeSystemMessagesIntoUser(input)
+
+	messages := gjson.GetBytes(got, "messages").Array()
+	if len(messages) != 2 {
+		t.Fatalf("expected system to be converted, got %d messages: %s", len(messages), string(got))
+	}
+	if role := messages[0].Get("role").String(); role != "user" {
+		t.Fatalf("first message role = %q, want user", role)
+	}
+	if content := messages[0].Get("content").String(); content != "only system" {
+		t.Fatalf("system content must not be dropped, got %q", content)
+	}
+	if role := messages[1].Get("role").String(); role != "assistant" {
+		t.Fatalf("assistant message must be preserved, got role %q", role)
+	}
+}
+
+func TestMergeSystemMessagesIntoUserWithMultimodalUserKeepsLooking(t *testing.T) {
+	input := []byte(`{"model":"m","messages":[` +
+		`{"role":"system","content":"sys"},` +
+		`{"role":"user","content":[{"type":"text","text":"see image"},{"type":"image_url","image_url":{"url":"https://example.com/a.png"}}]},` +
+		`{"role":"user","content":"plain"}]}`)
+
+	got := MergeSystemMessagesIntoUser(input)
+
+	messages := gjson.GetBytes(got, "messages").Array()
+	if len(messages) != 2 {
+		t.Fatalf("expected 2 messages, got %d: %s", len(messages), string(got))
+	}
+	if !messages[0].Get("content").IsArray() {
+		t.Fatalf("multimodal user content must stay an array, got %s", messages[0].Get("content").Raw)
+	}
+	if content := messages[1].Get("content").String(); content != "sys\n\nplain" {
+		t.Fatalf("system text should attach to the next text user turn, got %q", content)
+	}
+}
+
+func TestMergeSystemMessagesIntoUserProducesValidJSONForLargePayload(t *testing.T) {
+	bigSystem := strings.Repeat("System instruction line with \"quotes\" and \\backslash.\n", 4000)
+	userTurns := `{"role":"user","content":"` + strings.Repeat("user text ", 500) + `"}`
+	input := []byte(`{"model":"m","stream":true,"tools":[{"type":"function","function":{"name":"t"}}],"messages":[` +
+		`{"role":"system","content":` + mustJSONString(bigSystem) + `},` +
+		userTurns + `]}`)
+
+	got := MergeSystemMessagesIntoUser(input)
+
+	if !gjson.ValidBytes(got) {
+		t.Fatal("merged payload must stay valid JSON")
+	}
+	messages := gjson.GetBytes(got, "messages").Array()
+	if len(messages) != 1 {
+		t.Fatalf("expected 1 message, got %d", len(messages))
+	}
+	content := messages[0].Get("content").String()
+	if !strings.HasPrefix(content, "System instruction line") {
+		t.Fatalf("merged content must start with the system text, got %.80q", content)
+	}
+	if !strings.Contains(content, "user text") {
+		t.Fatal("original user text must be preserved after the system text")
+	}
+	if len(gjson.GetBytes(got, "tools").Array()) != 1 {
+		t.Fatal("unrelated top-level fields must survive the rewrite")
+	}
+}
+
+// mustJSONString quotes a string for embedding inside a hand written JSON literal.
+func mustJSONString(s string) string {
+	replacer := strings.NewReplacer(`\`, `\\`, `"`, `\"`, "\n", `\n`, "\r", `\r`, "\t", `\t`)
+	return `"` + replacer.Replace(s) + `"`
+}
