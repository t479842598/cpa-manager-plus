index 00000000..055ba20b
--- /dev/null
+++ b/internal/runtime/executor/helps/openai_compat_system_role.go
@@ -0,0 +1,150 @@
+package helps
+
+import (
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// ShouldMergeSystemIntoUser reports whether the selected openai-compatibility provider
+// asked for system messages to be folded into the first user message.
+//
+// Some OpenAI-compatible relays (new-api style) reject the system role outright with a
+// generic 400 ("service temporarily unavailable"), which breaks clients that ship a large
+// system prompt (e.g. ZCode sends a ~10KB system message). The flag is provider scoped
+// because the defect lives in the relay, not in a specific model, so no per-model
+// override is needed.
+func ShouldMergeSystemIntoUser(compat *config.OpenAICompatibility) bool {
+	if compat == nil {
+		return false
+	}
+	return compat.MergeSystemIntoUser
+}
+
+// MergeSystemMessagesIntoUser rewrites the messages array so that no string-content
+// system message remains:
+//
+//   - string-content system messages are collected in order and prepended (separated by a
+//     blank line) to the first user message, which preserves the instruction semantics
+//     instead of degrading it to a plain user turn;
+//   - when there is no string-content user message to attach to, the collected text is
+//     emitted as a user message inserted before the first non-assistant message, so the
+//     content is never dropped;
+//   - system messages carrying array content are left untouched (their structure is not
+//     guessed);
+//   - empty system messages are dropped.
+//
+// The function is a no-op (and returns the caller's slice) when there is nothing to do,
+// which keeps the disabled path allocation free.
+func MergeSystemMessagesIntoUser(payload []byte) []byte {
+	messages := gjson.GetBytes(payload, "messages")
+	if !messages.Exists() || !messages.IsArray() {
+		return payload
+	}
+
+	rawList := messages.Array()
+	if len(rawList) == 0 {
+		return payload
+	}
+
+	kept := make([][]byte, 0, len(rawList)+1)
+	pending := make([]string, 0, 2)
+	sawMergeableSystem := false
+	// Index in `kept` where the first dropped system message used to sit, so a synthetic
+	// user turn can be put back at the same relative position.
+	firstSystemAt := 0
+
+	for _, msg := range rawList {
+		if msg.Get("role").String() != "system" {
+			kept = append(kept, []byte(msg.Raw))
+			continue
+		}
+
+		content := msg.Get("content")
+		// Array content is structured (multimodal parts); rewriting it would require
+		// guessing the upstream schema, so such messages are preserved verbatim.
+		if content.IsArray() {
+			kept = append(kept, []byte(msg.Raw))
+			continue
+		}
+
+		if !sawMergeableSystem {
+			firstSystemAt = len(kept)
+		}
+		sawMergeableSystem = true
+		if text := content.String(); text != "" {
+			pending = append(pending, text)
+		}
+		// Empty (or missing) system messages contribute nothing and are dropped.
+	}
+
+	if !sawMergeableSystem {
+		return payload
+	}
+
+	merged := strings.Join(pending, "\n\n")
+	attached := false
+
+	if merged != "" {
+		for i := range kept {
+			if gjson.GetBytes(kept[i], "role").String() != "user" {
+				continue
+			}
+			existing := gjson.GetBytes(kept[i], "content")
+			if existing.Type != gjson.String {
+				// Multimodal user content cannot be prefixed with plain text without
+				// guessing the schema; skip it and keep looking for a text user turn.
+				continue
+			}
+			combined := merged
+			if existing.String() != "" {
+				combined = merged + "\n\n" + existing.String()
+			}
+			updated, errSet := sjson.SetBytes(kept[i], "content", combined)
+			if errSet != nil {
+				continue
+			}
+			kept[i] = updated
+			attached = true
+			break
+		}
+	}
+
+	if !attached && merged != "" {
+		// No attachable user turn: emit the text as a user message at the position the first
+		// system message used to occupy, so ordering relative to assistant turns is kept.
+		synthetic := []byte(`{"role":"user","content":""}`)
+		if updated, errSet := sjson.SetBytes(synthetic, "content", merged); errSet == nil {
+			synthetic = updated
+		}
+		insertAt := firstSystemAt
+		if insertAt > len(kept) {
+			insertAt = len(kept)
+		}
+		// Build a fresh slice rather than shifting in place: the repository keeps request
+		// payload buffers immutable, and the no-copy invariant test rejects copy() over them.
+		withSynthetic := make([][]byte, 0, len(kept)+1)
+		withSynthetic = append(withSynthetic, kept[:insertAt]...)
+		withSynthetic = append(withSynthetic, synthetic)
+		withSynthetic = append(withSynthetic, kept[insertAt:]...)
+		kept = withSynthetic
+	}
+
+	if len(kept) == 0 {
+		// Every message was an empty system message; keep the array shape valid.
+		kept = append(kept, []byte(`{"role":"user","content":""}`))
+	}
+
+	// Rebuild the messages array in one write so indices never shift mid-edit.
+	encoded := make([]string, 0, len(kept))
+	for _, raw := range kept {
+		encoded = append(encoded, string(raw))
+	}
+	out, errSet := sjson.SetRawBytes(payload, "messages", []byte("["+strings.Join(encoded, ",")+"]"))
+	if errSet != nil {
+		return payload
+	}
+	return out
+}
