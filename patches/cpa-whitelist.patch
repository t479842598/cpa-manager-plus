+package config
+
+import (
+	"testing"
+
+	"gopkg.in/yaml.v3"
+)
+
+func TestOpenAICompatibilityMergeSystemIntoUserConfigDecoding(t *testing.T) {
+	const yamlConfig = `openai-compatibility:
+  - name: beiluoxi
+    base-url: https://beiluoxi.top/v1
+    merge-system-into-user: true
+    api-key-entries:
+      - api-key: sk-test
+    models:
+      - name: deepseek-v4.1-flash
+        alias: 北洛/deepseek-v4.1-flash
+  - name: plain-upstream
+    base-url: https://example.com/v1
+    api-key-entries:
+      - api-key: sk-test-2
+    models:
+      - name: gpt-4o
+        alias: gpt-4o
+`
+
+	var cfg Config
+	if errDecode := yaml.Unmarshal([]byte(yamlConfig), &cfg); errDecode != nil {
+		t.Fatalf("decode error: %v", errDecode)
+	}
+
+	if len(cfg.OpenAICompatibility) != 2 {
+		t.Fatalf("openai-compatibility entries = %d, want 2", len(cfg.OpenAICompatibility))
+	}
+	if !cfg.OpenAICompatibility[0].MergeSystemIntoUser {
+		t.Fatalf("merge-system-into-user = false, want true: %+v", cfg.OpenAICompatibility[0])
+	}
+	if cfg.OpenAICompatibility[1].MergeSystemIntoUser {
+		t.Fatal("omitted merge-system-into-user must default to false")
+	}
+}
+
+func TestOpenAICompatibilityMergeSystemIntoUserSurvivesClone(t *testing.T) {
+	cfg := &Config{
+		OpenAICompatibility: []OpenAICompatibility{{
+			Name:                "beiluoxi",
+			BaseURL:             "https://beiluoxi.top/v1",
+			MergeSystemIntoUser: true,
+			APIKeyEntries:       []OpenAICompatibilityAPIKey{{APIKey: "sk-test"}},
+			Models:              []OpenAICompatibilityModel{{Name: "deepseek-v4.1-flash", Alias: "北洛/deepseek-v4.1-flash"}},
+		}},
+	}
+
+	clone := cfg.CloneForRuntime()
+	if clone == nil || len(clone.OpenAICompatibility) != 1 {
+		t.Fatal("clone lost openai-compatibility entries")
+	}
+	if !clone.OpenAICompatibility[0].MergeSystemIntoUser {
+		t.Fatal("CloneForRuntime dropped merge-system-into-user")
+	}
+
+	// Independent copies: mutating the clone must not affect the source.
+	clone.OpenAICompatibility[0].MergeSystemIntoUser = false
+	if !cfg.OpenAICompatibility[0].MergeSystemIntoUser {
+		t.Fatal("clone shares the flag with the source config")
+	}
+}
+
+func TestSanitizeOpenAICompatibilityKeepsMergeFlag(t *testing.T) {
+	cfg := &Config{
+		OpenAICompatibility: []OpenAICompatibility{
+			{
+				Name:                "  beiluoxi  ",
+				BaseURL:             "  https://beiluoxi.top/v1  ",
+				MergeSystemIntoUser: true,
+			},
+			{
+				Name:    "dropped",
+				BaseURL: "   ",
+			},
+		},
+	}
+
+	cfg.SanitizeOpenAICompatibility()
+
+	if len(cfg.OpenAICompatibility) != 1 {
+		t.Fatalf("entries after sanitize = %d, want 1", len(cfg.OpenAICompatibility))
+	}
+	if !cfg.OpenAICompatibility[0].MergeSystemIntoUser {
+		t.Fatal("sanitize dropped the merge flag")
+	}
+	if cfg.OpenAICompatibility[0].Name != "beiluoxi" {
+		t.Fatalf("name = %q, want trimmed", cfg.OpenAICompatibility[0].Name)
+	}
+}
