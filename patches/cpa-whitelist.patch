@@ -0,0 +1,123 @@
+package management
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	sdkaccess "github.com/router-for-me/CLIProxyAPI/v7/sdk/access"
+)
+
+func registerManagementModelsTestClient(t *testing.T) (want, omitted string) {
+	t.Helper()
+	clientID := "management-models-test"
+	want = "mgmt-models-test/alpha"
+	omitted = "mgmt-models-test/beta"
+	registry.GetGlobalRegistry().RegisterClient(clientID, "OpenAI", []*registry.ModelInfo{
+		{ID: want, Object: "model", OwnedBy: "test"},
+		{ID: omitted, Object: "model", OwnedBy: "test"},
+	})
+	t.Cleanup(func() {
+		registry.GetGlobalRegistry().UnregisterClient(clientID)
+	})
+	return want, omitted
+}
+
+// F-02: GET /v0/management/models returns the full catalogue even when the
+// request context carries a per-key whitelist. This is the endpoint the control
+// panel relies on so that editing a whitelist is never limited to whatever the
+// first configured api key happens to be allowed to see.
+func TestGetModelsIgnoresPerKeyWhitelist(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	want, omitted := registerManagementModelsTestClient(t)
+
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	ctx := sdkaccess.WithAuthMetadata(context.Background(), map[string]string{
+		// Only one of the two registered models would survive a whitelist filter.
+		"model-whitelist": want,
+	})
+	c.Request = httptest.NewRequest(http.MethodGet, "/v0/management/models", nil).WithContext(ctx)
+
+	(&Handler{}).GetModels(c)
+
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200 (body %s)", recorder.Code, recorder.Body.String())
+	}
+
+	var payload struct {
+		Object   string           `json:"object"`
+		Protocol string           `json:"protocol"`
+		Total    int              `json:"total"`
+		Data     []map[string]any `json:"data"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &payload); err != nil {
+		t.Fatalf("decode: %v (%s)", err, recorder.Body.String())
+	}
+	if payload.Object != "list" {
+		t.Fatalf("object = %q, want list", payload.Object)
+	}
+	if payload.Protocol != "openai" {
+		t.Fatalf("protocol = %q, want openai", payload.Protocol)
+	}
+	if payload.Total != len(payload.Data) {
+		t.Fatalf("total = %d but data length = %d", payload.Total, len(payload.Data))
+	}
+
+	body := recorder.Body.String()
+	for _, id := range []string{want, omitted} {
+		if !strings.Contains(body, id) {
+			t.Fatalf("full catalogue should contain %q even with a whitelist on the context", id)
+		}
+	}
+}
+
+// F-02: entries are normalised to the public fields and blank ids are dropped.
+func TestGetModelsProjectsPublicFields(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	clientID := "management-models-projection"
+	wantID := "mgmt-models-test/projected"
+	registry.GetGlobalRegistry().RegisterClient(clientID, "OpenAI", []*registry.ModelInfo{
+		{ID: wantID, Object: "model", OwnedBy: "test-owner", Created: 1771111111, DisplayName: "Should Not Leak"},
+		{ID: "   ", Object: "model"},
+	})
+	t.Cleanup(func() {
+		registry.GetGlobalRegistry().UnregisterClient(clientID)
+	})
+
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodGet, "/v0/management/models", nil).WithContext(context.Background())
+
+	(&Handler{}).GetModels(c)
+
+	var payload struct {
+		Data []map[string]any `json:"data"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &payload); err != nil {
+		t.Fatalf("decode: %v (%s)", err, recorder.Body.String())
+	}
+	var found map[string]any
+	for _, item := range payload.Data {
+		if id, _ := item["id"].(string); id == wantID {
+			found = item
+		}
+		if id, _ := item["id"].(string); strings.TrimSpace(id) == "" {
+			t.Fatalf("blank model id must be dropped, got %v", item)
+		}
+	}
+	if found == nil {
+		t.Fatalf("model %q missing from response", wantID)
+	}
+	if found["owned_by"] != "test-owner" {
+		t.Fatalf("owned_by = %v, want test-owner", found["owned_by"])
+	}
+	if _, ok := found["display_name"]; ok {
+		t.Fatalf("display_name must not be projected, got %v", found)
+	}
+}
