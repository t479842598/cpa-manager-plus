+func TestShouldMergeSystemIntoUser(t *testing.T) {
+	t.Run("nil compat returns false", func(t *testing.T) {
+		if ShouldMergeSystemIntoUser(nil) {
+			t.Fatal("nil compat must not enable merging")
+		}
+	})
+
+	t.Run("omitted flag defaults to false", func(t *testing.T) {
+		if ShouldMergeSystemIntoUser(&config.OpenAICompatibility{Name: "beiluoxi"}) {
+			t.Fatal("omitted merge-system-into-user must default to false")
+		}
+	})
+
+	t.Run("explicit true enables merging", func(t *testing.T) {
+		if !ShouldMergeSystemIntoUser(&config.OpenAICompatibility{Name: "beiluoxi", MergeSystemIntoUser: true}) {
+			t.Fatal("merge-system-into-user: true must enable merging")
+		}
+	})
+}
+
+func TestMergeSystemMessagesIntoUserNoopWhenNothingToDo(t *testing.T) {
+	cases := map[string]string{
+		"no messages key":     `{"model":"m","input":"hi"}`,
+		"messages not array":  `{"model":"m","messages":"oops"}`,
+		"empty messages":      `{"model":"m","messages":[]}`,
+		"no system message":   `{"model":"m","messages":[{"role":"user","content":"hi"}]}`,
+		"array system only":   `{"model":"m","messages":[{"role":"system","content":[{"type":"text","text":"s"}]},{"role":"user","content":"hi"}]}`,
+		"developer untouched": `{"model":"m","messages":[{"role":"developer","content":"d"},{"role":"user","content":"hi"}]}`,
+	}
+
+	for name, input := range cases {
+		t.Run(name, func(t *testing.T) {
+			// The slice identity must be preserved so the disabled path stays allocation free.
+			payload := []byte(input)
+			got := MergeSystemMessagesIntoUser(payload)
+			if len(got) != len(payload) || &got[0] != &payload[0] {
+				t.Fatalf("payload should be returned untouched, got %s", string(got))
+			}
+		})
+	}
+}
+
+func TestMergeSystemMessagesIntoUserSingleSystem(t *testing.T) {
+	input := []byte(`{"model":"m","messages":[` +
+		`{"role":"system","content":"You are a helpful assistant."},` +
+		`{"role":"user","content":"hello"}]}`)
+
+	got := MergeSystemMessagesIntoUser(input)
+
+	messages := gjson.GetBytes(got, "messages").Array()
+	if len(messages) != 1 {
+		t.Fatalf("expected the system message to be folded away, got %d messages: %s", len(messages), string(got))
+	}
+	if role := messages[0].Get("role").String(); role != "user" {
+		t.Fatalf("remaining role = %q, want user", role)
+	}
+	want := "You are a helpful assistant.\n\nhello"
+	if content := messages[0].Get("content").String(); content != want {
+		t.Fatalf("merged content = %q, want %q", content, want)
+	}
+	if model := gjson.GetBytes(got, "model").String(); model != "m" {
+		t.Fatalf("unrelated fields must survive, model = %q", model)
+	}
+}
+
+func TestMergeSystemMessagesIntoUserKeepsOtherRoles(t *testing.T) {
+	input := []byte(`{"model":"m","messages":[` +
+		`{"role":"system","content":"S1"},` +
+		`{"role":"user","content":"U1"},` +
+		`{"role":"assistant","content":"A1"},` +
+		`{"role":"user","content":"U2"}]}`)
+
+	got := MergeSystemMessagesIntoUser(input)
+
+	messages := gjson.GetBytes(got, "messages").Array()
