@@ -0,0 +1,132 @@
+package executor
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// runFinishRepairStream serves the given SSE body through an OpenAI-compatible
+// upstream and returns the translated payloads the executor publishes.
+func runFinishRepairStream(t *testing.T, sseBody string) []string {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = w.Write([]byte(sseBody))
+	}))
+	defer server.Close()
+
+	exec := NewOpenAICompatExecutor("openai-compatibility", &config.Config{})
+	auth := &cliproxyauth.Auth{
+		Provider: "openai-compatibility",
+		Attributes: map[string]string{
+			"base_url": server.URL + "/v1",
+			"api_key":  "test",
+		},
+	}
+	result, errExecute := exec.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{
+		Model:   "FB/deepseek-v4-flash",
+		Payload: []byte(`{"model":"FB/deepseek-v4-flash","messages":[{"role":"user","content":"hi"}],"stream":true}`),
+	}, cliproxyexecutor.Options{
+		SourceFormat:   sdktranslator.FromString("openai"),
+		ResponseFormat: sdktranslator.FromString("openai"),
+		Stream:         true,
+	})
+	if errExecute != nil {
+		t.Fatalf("ExecuteStream error: %v", errExecute)
+	}
+	var payloads []string
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("stream chunk error: %v", chunk.Err)
+		}
+		payloads = append(payloads, string(chunk.Payload))
+	}
+	return payloads
+}
+
+func countFinishReasonChunks(payloads []string) int {
+	n := 0
+	for _, p := range payloads {
+		if fr := gjson.Get(p, "choices.0.finish_reason"); fr.Exists() && fr.Type == gjson.String && fr.String() != "" {
+			n++
+		}
+	}
+	return n
+}
+
+func TestOpenAICompatExecutorSynthesizesMissingFinishReason(t *testing.T) {
+	// Upstream streams complete content but ends without any finish_reason chunk.
+	payloads := runFinishRepairStream(t,
+		"data: {\"id\":\"chatcmpl-x1\",\"model\":\"FB/deepseek-v4-flash\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hel\"},\"finish_reason\":null}]}\n\n"+
+			"data: {\"id\":\"chatcmpl-x1\",\"model\":\"FB/deepseek-v4-flash\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"lo\"},\"finish_reason\":null}]}\n\n"+
+			"data: [DONE]\n\n")
+	if got := countFinishReasonChunks(payloads); got != 1 {
+		t.Fatalf("finish_reason chunks = %d, want 1; payloads=%v", got, payloads)
+	}
+	last := payloads[len(payloads)-1]
+	if fr := gjson.Get(last, "choices.0.finish_reason").String(); fr != "stop" {
+		t.Fatalf("synthesized finish_reason = %q, want stop; payload=%s", fr, last)
+	}
+	if id := gjson.Get(last, "id").String(); id != "chatcmpl-x1" {
+		t.Fatalf("synthesized chunk id = %q, want chatcmpl-x1", id)
+	}
+	if m := gjson.Get(last, "model").String(); m != "FB/deepseek-v4-flash" {
+		t.Fatalf("synthesized chunk model = %q", m)
+	}
+}
+
+func TestOpenAICompatExecutorSynthesizesToolCallsFinishReason(t *testing.T) {
+	payloads := runFinishRepairStream(t,
+		"data: {\"id\":\"chatcmpl-x2\",\"model\":\"m\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"get_time\",\"arguments\":\"{}\"}}]},\"finish_reason\":null}]}\n\n"+
+			"data: [DONE]\n\n")
+	if got := countFinishReasonChunks(payloads); got != 1 {
+		t.Fatalf("finish_reason chunks = %d, want 1; payloads=%v", got, payloads)
+	}
+	last := payloads[len(payloads)-1]
+	if fr := gjson.Get(last, "choices.0.finish_reason").String(); fr != "tool_calls" {
+		t.Fatalf("synthesized finish_reason = %q, want tool_calls; payload=%s", fr, last)
+	}
+}
+
+func TestOpenAICompatExecutorKeepsExistingFinishReason(t *testing.T) {
+	payloads := runFinishRepairStream(t,
+		"data: {\"id\":\"chatcmpl-x3\",\"model\":\"m\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"ok\"},\"finish_reason\":null}]}\n\n"+
+			"data: {\"id\":\"chatcmpl-x3\",\"model\":\"m\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n"+
+			"data: [DONE]\n\n")
+	if got := countFinishReasonChunks(payloads); got != 1 {
+		t.Fatalf("finish_reason chunks = %d, want 1 (no duplicate synthesis); payloads=%v", got, payloads)
+	}
+	if !strings.Contains(payloads[len(payloads)-1], "\"finish_reason\":\"stop\"") {
+		t.Fatalf("last payload should be the upstream finish chunk, got %s", payloads[len(payloads)-1])
+	}
+}
+
+func TestOpenAICompatExecutorSynthesizesOnEOFWithoutDone(t *testing.T) {
+	// Clean EOF without [DONE]: the executor already synthesizes [DONE]; the
+	// missing finish_reason must also be repaired before that marker.
+	payloads := runFinishRepairStream(t,
+		"data: {\"id\":\"chatcmpl-x4\",\"model\":\"m\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"tail\"},\"finish_reason\":null}]}\n\n")
+	if got := countFinishReasonChunks(payloads); got != 1 {
+		t.Fatalf("finish_reason chunks = %d, want 1; payloads=%v", got, payloads)
+	}
+	if fr := gjson.Get(payloads[len(payloads)-1], "choices.0.finish_reason").String(); fr != "stop" {
+		t.Fatalf("synthesized finish_reason = %q, want stop", fr)
+	}
+}
+
+func TestOpenAICompatExecutorEmptyStreamNotSynthesized(t *testing.T) {
+	// No content chunks at all: do not fabricate a terminal event.
+	payloads := runFinishRepairStream(t, "data: [DONE]\n\n")
+	if got := countFinishReasonChunks(payloads); got != 0 {
+		t.Fatalf("finish_reason chunks = %d, want 0 for empty stream; payloads=%v", got, payloads)
+	}
+}
