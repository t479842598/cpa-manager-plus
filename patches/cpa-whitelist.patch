+func TestIsGPT6FamilyModel(t *testing.T) {
+	cases := []struct {
+		model string
+		want  bool
+	}{
+		{"gpt-6-astra", true},
+		{"gpt-6", true},
+		{"gpt-6.0", true},
+		{"gpt-6-astra(high)", true},
+		{"teamA/gpt-6-astra", true},
+		{"GPT-6-Astra", true},
+		{" gpt-6-astra ", true},
+		{"gpt-5.5", false},
+		{"gpt-5.6-luna", false},
+		{"gpt-6x", false},
+		{"", false},
+		{"claude-sonnet-5", false},
+	}
+	for _, tc := range cases {
+		if got := isGPT6FamilyModel(tc.model); got != tc.want {
+			t.Errorf("isGPT6FamilyModel(%q) = %t, want %t", tc.model, got, tc.want)
+		}
+	}
+}
