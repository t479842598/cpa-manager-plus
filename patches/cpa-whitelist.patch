+package management
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"gopkg.in/yaml.v3"
+)
+
+func newAPIKeyModelsHandler(t *testing.T, models map[string][]string) *Handler {
+	t.Helper()
+
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.yaml")
+	if errWrite := os.WriteFile(path, []byte("{}\n"), 0o600); errWrite != nil {
+		t.Fatalf("failed to write test config: %v", errWrite)
+	}
+	cfg := &config.Config{}
+	cfg.APIKeyModels = models
+	return &Handler{
+		cfg:            cfg,
+		configFilePath: path,
+	}
+}
+
+func performJSON(h *Handler, method, target, body string, fn func(*gin.Context)) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(rec)
+	req := httptest.NewRequest(method, target, strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	c.Request = req
+	fn(c)
+	return rec
+}
+
+func readAPIKeyModelsFromDisk(t *testing.T, h *Handler) map[string][]string {
+	t.Helper()
+
+	data, errRead := os.ReadFile(h.configFilePath)
+	if errRead != nil {
+		t.Fatalf("failed to read persisted config: %v", errRead)
+	}
+	var parsed struct {
+		APIKeyModels map[string][]string `yaml:"api-key-models"`
+	}
+	if errUnmarshal := yaml.Unmarshal(data, &parsed); errUnmarshal != nil {
+		t.Fatalf("failed to parse persisted config: %v", errUnmarshal)
+	}
+	return parsed.APIKeyModels
+}
+
+func TestGetAPIKeyModels_EmptyReturnsEmptyObject(t *testing.T) {
+	t.Parallel()
+
+	h := newAPIKeyModelsHandler(t, nil)
+	rec := performJSON(h, http.MethodGet, "/v0/management/api-key-models", "", h.GetAPIKeyModels)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d; body=%s", rec.Code, http.StatusOK, rec.Body.String())
+	}
+	var payload map[string]map[string][]string
+	if errUnmarshal := json.Unmarshal(rec.Body.Bytes(), &payload); errUnmarshal != nil {
+		t.Fatalf("failed to parse response: %v", errUnmarshal)
+	}
+	got, ok := payload["api-key-models"]
+	if !ok {
+		t.Fatalf("response missing api-key-models field: %s", rec.Body.String())
+	}
+	if got == nil {
+		t.Fatalf("api-key-models = null, want empty object")
+	}
+	if len(got) != 0 {
+		t.Fatalf("api-key-models = %#v, want empty", got)
+	}
+}
+
+func TestPatchAPIKeyModels_SetsAndPersistsWhitelist(t *testing.T) {
+	t.Parallel()
+
+	h := newAPIKeyModelsHandler(t, nil)
+	rec := performJSON(
+		h,
+		http.MethodPatch,
+		"/v0/management/api-key-models",
+		`{"api-key":"sk-restricted","models":["  model-a ","model-b","model-a",""]}`,
+		h.PatchAPIKeyModels,
+	)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d; body=%s", rec.Code, http.StatusOK, rec.Body.String())
+	}
+	got := h.cfg.APIKeyModels["sk-restricted"]
+	if len(got) != 2 || got[0] != "model-a" || got[1] != "model-b" {
+		t.Fatalf("in-memory whitelist = %#v, want [model-a model-b]", got)
+	}
+	persisted := readAPIKeyModelsFromDisk(t, h)
+	if len(persisted["sk-restricted"]) != 2 {
+		t.Fatalf("persisted whitelist = %#v, want 2 entries", persisted)
+	}
+}
+
+func TestPatchAPIKeyModels_EmptyModelsRemovesEntry(t *testing.T) {
+	t.Parallel()
+
+	h := newAPIKeyModelsHandler(t, map[string][]string{
+		"sk-a": {"model-a"},
+		"sk-b": {"model-b"},
+	})
+	rec := performJSON(
+		h,
+		http.MethodPatch,
+		"/v0/management/api-key-models",
+		`{"api-key":"sk-a","models":[]}`,
+		h.PatchAPIKeyModels,
+	)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d; body=%s", rec.Code, http.StatusOK, rec.Body.String())
+	}
+	if _, ok := h.cfg.APIKeyModels["sk-a"]; ok {
+		t.Fatalf("sk-a whitelist still present after empty patch: %#v", h.cfg.APIKeyModels)
+	}
+	if len(h.cfg.APIKeyModels) != 1 {
+		t.Fatalf("whitelist map = %#v, want only sk-b", h.cfg.APIKeyModels)
+	}
+	if persisted := readAPIKeyModelsFromDisk(t, h); len(persisted) != 1 {
+		t.Fatalf("persisted whitelist = %#v, want only sk-b", persisted)
+	}
+}
+
+// Clearing the whitelist of a key that never had one is a no-op success: the
+// panel sends the desired end state, not a diff.
+func TestPatchAPIKeyModels_EmptyModelsOnUnknownKeyIsIdempotent(t *testing.T) {
+	t.Parallel()
+
+	h := newAPIKeyModelsHandler(t, map[string][]string{"sk-a": {"model-a"}})
+	rec := performJSON(
+		h,
+		http.MethodPatch,
+		"/v0/management/api-key-models",
+		`{"api-key":"sk-missing","models":[]}`,
+		h.PatchAPIKeyModels,
+	)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d; body=%s", rec.Code, http.StatusOK, rec.Body.String())
+	}
+	if len(h.cfg.APIKeyModels) != 1 {
+		t.Fatalf("whitelist map mutated by idempotent patch: %#v", h.cfg.APIKeyModels)
+	}
+}
+
+func TestPatchAPIKeyModels_RequiresAPIKey(t *testing.T) {
+	t.Parallel()
+
+	h := newAPIKeyModelsHandler(t, nil)
+	rec := performJSON(
+		h,
+		http.MethodPatch,
+		"/v0/management/api-key-models",
+		`{"models":["model-a"]}`,
+		h.PatchAPIKeyModels,
+	)
+
+	if rec.Code != http.StatusBadRequest {
+		t.Fatalf("status = %d, want %d; body=%s", rec.Code, http.StatusBadRequest, rec.Body.String())
+	}
+}
+
+func TestPutAPIKeyModels_ReplacesWholeMap(t *testing.T) {
+	t.Parallel()
