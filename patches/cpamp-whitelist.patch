diff --git a/apps/web/src/services/api/apiKeyModels.test.ts b/apps/web/src/services/api/apiKeyModels.test.ts
new file mode 100644
index 00000000..5c27bfeb
--- /dev/null
+++ b/apps/web/src/services/api/apiKeyModels.test.ts
@@ -0,0 +1,114 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const { mocks } = vi.hoisted(() => ({
+  mocks: {
+    get: vi.fn(),
+    put: vi.fn(),
+    patch: vi.fn(),
+    delete: vi.fn(),
+  },
+}));
+
+vi.mock('./client', () => ({
+  apiClient: {
+    get: mocks.get,
+    put: mocks.put,
+    patch: mocks.patch,
+    delete: mocks.delete,
+  },
+}));
+
+import { apiKeyModelsApi, parseAPIKeyModelsResponse } from './apiKeyModels';
+
+beforeEach(() => {
+  mocks.get.mockReset();
+  mocks.put.mockReset();
+  mocks.patch.mockReset();
+  mocks.delete.mockReset();
+});
+
+describe('apiKeyModelsApi.list response contract', () => {
+  it('returns an empty map for an explicit null whitelist', () => {
+    expect(parseAPIKeyModelsResponse({ 'api-key-models': null })).toEqual({});
+  });
+
+  it('accepts the camelCase field name', () => {
+    expect(parseAPIKeyModelsResponse({ apiKeyModels: { 'sk-a': ['model-a'] } })).toEqual({
+      'sk-a': ['model-a'],
+    });
+  });
+
+  it('rejects a response without the whitelist field', () => {
+    expect(() => parseAPIKeyModelsResponse({ 'api-keys': ['sk-a'] })).toThrow(
+      'Invalid API key model whitelist response'
+    );
+  });
+
+  it('rejects a whitelist value that is not a list', () => {
+    expect(() => parseAPIKeyModelsResponse({ 'api-key-models': { 'sk-a': 'model-a' } })).toThrow(
+      'Invalid API key model whitelist response'
+    );
+  });
+
+  it('trims model names and drops keys whose whitelist is empty', () => {
+    expect(
+      parseAPIKeyModelsResponse({
+        'api-key-models': {
+          ' sk-a ': [' model-a ', ''],
+          'sk-empty': [],
+        },
+      })
+    ).toEqual({ 'sk-a': ['model-a'] });
+  });
+});
+
+describe('apiKeyModelsApi mutations', () => {
+  it('sends a declarative patch per key', async () => {
+    mocks.patch.mockResolvedValue({ status: 'ok' });
+
+    await apiKeyModelsApi.setForKey('sk-a', ['model-a', 'model-b']);
+
+    expect(mocks.patch).toHaveBeenCalledWith('/api-key-models', {
+      'api-key': 'sk-a',
+      models: ['model-a', 'model-b'],
+    });
+  });
+
+  it('clearing the whitelist still goes through patch, not delete', async () => {
+    mocks.patch.mockResolvedValue({ status: 'ok' });
+
+    await apiKeyModelsApi.setForKey('sk-a', []);
+
+    expect(mocks.patch).toHaveBeenCalledWith('/api-key-models', {
+      'api-key': 'sk-a',
+      models: [],
+    });
+    expect(mocks.delete).not.toHaveBeenCalled();
+  });
+
+  it('url-encodes the key when deleting a whitelist entry', async () => {
+    mocks.delete.mockResolvedValue({ status: 'ok' });
+
+    await apiKeyModelsApi.deleteForKey('sk-a/b');
+
+    expect(mocks.delete).toHaveBeenCalledWith('/api-key-models?api-key=sk-a%2Fb');
+  });
+});
+
+describe('apiKeyModelsApi model catalogue', () => {
+  it('reads the full catalogue from the management endpoint', async () => {
+    mocks.get.mockResolvedValue({
+      object: 'list',
+      data: [{ id: 'model-a' }, { id: 'model-b' }, { id: 'model-a' }, { noId: true }],
+    });
+
+    await expect(apiKeyModelsApi.listModelCatalogue()).resolves.toEqual(['model-a', 'model-b']);
+    expect(mocks.get).toHaveBeenCalledWith('/models');
+  });
+
+  it('returns an empty list when the catalogue payload is malformed', async () => {
+    mocks.get.mockResolvedValue({ unexpected: true });
+
+    await expect(apiKeyModelsApi.listModelCatalogue()).resolves.toEqual([]);
+  });
+});
diff --git a/apps/web/src/services/api/apiKeyModels.ts b/apps/web/src/services/api/apiKeyModels.ts
new file mode 100644
index 00000000..9a5390ea
--- /dev/null
+++ b/apps/web/src/services/api/apiKeyModels.ts
@@ -0,0 +1,108 @@
+/**
+ * Per-key model whitelist (CPA `api-key-models`) and the management model catalogue.
+ *
+ * CPA's management API exposes the whitelist next to `api-keys` itself, so a key
+ * and its whitelist are persisted through the same channel instead of rewriting
+ * config.yaml as a whole.
+ */
+
+import { apiClient } from './client';
+
+const INVALID_WHITELIST_RESPONSE = 'Invalid API key model whitelist response';
+
+type WhitelistMap = Record<string, string[]>;
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+
+const normalizeKeyModels = (raw: unknown): WhitelistMap => {
+  if (!isRecord(raw)) {
+    throw new Error(INVALID_WHITELIST_RESPONSE);
+  }
+  const entries: WhitelistMap = {};
+  for (const [key, models] of Object.entries(raw)) {
+    const trimmedKey = String(key ?? '').trim();
+    if (!trimmedKey) continue;
+    if (!Array.isArray(models)) {
+      throw new Error(INVALID_WHITELIST_RESPONSE);
+    }
+    const names = models
+      .map((model) => String(model ?? '').trim())
+      .filter((model) => model.length > 0);
+    if (names.length === 0) continue;
+    entries[trimmedKey] = names;
+  }
+  return entries;
+};
+
+export const parseAPIKeyModelsResponse = (data: unknown): WhitelistMap => {
+  if (!isRecord(data)) {
+    throw new Error(INVALID_WHITELIST_RESPONSE);
+  }
+  const hasKebabCaseField = Object.prototype.hasOwnProperty.call(data, 'api-key-models');
+  const hasCamelCaseField = Object.prototype.hasOwnProperty.call(data, 'apiKeyModels');
+  if (!hasKebabCaseField && !hasCamelCaseField) {
+    throw new Error(INVALID_WHITELIST_RESPONSE);
+  }
+  const raw = hasKebabCaseField ? data['api-key-models'] : data.apiKeyModels;
+  if (raw == null) return {};
+  return normalizeKeyModels(raw);
+};
+
+const parseModelCatalogue = (payload: unknown): string[] => {
+  if (!isRecord(payload) || !Array.isArray(payload.data)) {
+    return [];
+  }
+  return Array.from(
+    new Set(
+      payload.data
+        .map((item) => (isRecord(item) ? String(item.id ?? '').trim() : ''))
+        .filter((id) => id.length > 0)
+    )
+  );
+};
+
+export const apiKeyModelsApi = {
+  /** Full whitelist map, limited to keys that are actually restricted. */
+  async list(): Promise<WhitelistMap> {
+    const data = await apiClient.get<unknown>('/api-key-models');
+    return parseAPIKeyModelsResponse(data);
+  },
+
+  /**
+   * Declarative sync of one key: a non-empty list restricts the key to exactly
+   * those models, an empty list removes the restriction.
+   */
+  setForKey: (apiKey: string, models: string[]) =>
+    apiClient.patch('/api-key-models', { 'api-key': apiKey, models }),
+
+  deleteForKey: (apiKey: string) =>
+    apiClient.delete(`/api-key-models?api-key=${encodeURIComponent(apiKey)}`),
+
+  /**
+   * Model candidates for the whitelist editor.
+   *
+   * Preferred source is GET /v0/management/models, which reads CPA's registry
+   * directly and therefore always reports the full catalogue — unlike
+   * /v1/models, which is filtered by the probing key's own whitelist.
+   */
+  async listModelCatalogue(): Promise<string[]> {
+    const payload = await apiClient.get<unknown>('/models');
+    return parseModelCatalogue(payload);
+  },
+
+  /**
+   * Fallback probe used when the management catalogue is unavailable: CPA
+   * requires a client key on /v1/models, and the list is filtered by that
+   * key's whitelist, so callers must flag the result as possibly incomplete.
+   */
+  async probeClientModels(bearerKey: string): Promise<string[]> {
+    const authHeader = bearerKey ? { Authorization: `Bearer ${bearerKey}` } : undefined;
+    const response = await fetch('/v1/models', { headers: authHeader });
+    if (!response.ok) {
+      throw new Error(`HTTP ${response.status}`);
+    }
+    const payload = (await response.json()) as { data?: Array<{ id?: string }> };
+    return parseModelCatalogue(payload);
+  },
+};
